# Jellyfin + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# JELLYFIN_IMAGE_TAG=jellyfin/jellyfin:12.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.jellyfin.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Jellyfin
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED. It is also what Jellyfin tells
# clients to come back to, so an app that discovered the server on the LAN
# still knows how to reach it from outside.
JELLYFIN_HOSTNAME=jellyfin.example.com

# Where your media actually lives on this host. Mounted READ-ONLY: Jellyfin
# never needs to write here, and a media server with write access to the
# library is one bad plugin away from a very long restore.
# Defaults to ./media so the stack starts before you have decided.
# JELLYFIN_MEDIA_PATH=/mnt/storage/media

# There is no password to set here. Jellyfin has no accounts until the setup
# wizard runs, and the wizard is open to whoever reaches it first.
# **Open the site and finish the wizard immediately after deploy.**

# Timezone used for scheduled tasks and for "added on" dates.
# JELLYFIN_TZ=Etc/UTC

# How long Traefik will hold a single response open. A film is one response
# that lasts as long as the film, so the default here is 0 — no limit. Raise
# the idle timeout instead if you want to reap abandoned connections sooner.
# JELLYFIN_STREAM_TIMEOUT=0s
# JELLYFIN_IDLE_TIMEOUT=600s

# ──────────────────────────────────────────────────────────────────────────────
# Hardware transcoding (only with hardware-transcoding.override.yml)
# ──────────────────────────────────────────────────────────────────────────────
#
# These are read ONLY when you add that file to the command line. Get them
# from the host, do not guess:
#     id -u                              -> JELLYFIN_UID
#     id -g                              -> JELLYFIN_GID
#     stat -c '%g' /dev/dri/renderD128   -> JELLYFIN_RENDER_GID
#     ls -l /dev/dri                     -> which card device exists
#
# JELLYFIN_UID=1000
# JELLYFIN_GID=1000
# JELLYFIN_RENDER_GID=104
# JELLYFIN_RENDER_DEVICE=/dev/dri/renderD128
# JELLYFIN_CARD_DEVICE=/dev/dri/card0

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────
#
# The archive covers /config: users, the library database with watch state,
# metadata, artwork, plugins and API keys. It does NOT cover your media — that
# is mounted read-only and belongs to whatever backs up the disk it lives on —
# and it does not cover the transcoding cache, which Jellyfin rebuilds.

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# DATA_BACKUP_PRUNE_DAYS=7
# DATA_BACKUPS_PATH=/srv/jellyfin-config/backups
# DATA_PATH=/config
# DATA_BACKUP_NAME=jellyfin-config-backup

# Resource limits (defaults shown). Software transcoding is what makes these
# numbers matter: one 4K stream re-encoded on the CPU will use every core it
# is given. With hardware transcoding on, most of this sits idle.
# JELLYFIN_MEMORY_LIMIT=4g
# JELLYFIN_CPU_LIMIT=4.0
# JELLYFIN_MEMORY_RESERVATION=512m
# JELLYFIN_CPU_RESERVATION=0.5
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# JELLYFIN_BACKUPS_MEMORY_LIMIT=256m
# JELLYFIN_BACKUPS_CPU_LIMIT=0.5
# JELLYFIN_BACKUPS_MEMORY_RESERVATION=16m
# JELLYFIN_BACKUPS_CPU_RESERVATION=0.1
# JELLYFIN_ORPHANS_MEMORY_LIMIT=256m
# JELLYFIN_ORPHANS_CPU_LIMIT=1.0
# JELLYFIN_ORPHANS_MEMORY_RESERVATION=32m
# JELLYFIN_ORPHANS_CPU_RESERVATION=0.1

# How long docker waits before SIGKILL. The config directory holds a SQLite
# library database that is written while anything is playing.
# JELLYFIN_STOP_GRACE_PERIOD=60s

# ──────────────────────────────────────────────────────────────────────────────
# Orphan cleanup (jellyfin-drop-orphans.sh)
# ──────────────────────────────────────────────────────────────────────────────

# How many library rows may point at a missing file before the tool refuses to
# remove any of them. Above this it prints the list and stops, because a large
# number of missing files is what an unmounted disk looks like and nothing in
# the database distinguishes the two. Raise it only after reading the list.
# Default: 50.
# JELLYFIN_ORPHAN_LIMIT=50

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image while every other pin stays as tested. Needs Docker
# Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# JELLYFIN_IMAGE_VERSION=12.0
# JELLYFIN_BACKUPS_IMAGE_VERSION=3.22
# JELLYFIN_ORPHANS_IMAGE_VERSION=3.13-alpine
